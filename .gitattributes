# Line-ending policy: bash/python scripts MUST be LF on every platform.
# Without this, checkouts with core.autocrlf=true convert .sh to CRLF and
# every bash script breaks with syntax errors (\r after line continuations).
* text=auto

# Shell scripts and hooks (bash requires LF)
*.sh text eol=lf
scripts/hooks/post-commit-workflow text eol=lf
scripts/hooks/pre-hook-wave-* text eol=lf
scripts/hooks/post-hook-wave-* text eol=lf

# Python (heredocs embedded in bash + consistency)
*.py text eol=lf

# Text formats (normalized in repo, platform EOL on checkout)
*.md text
*.json text
*.yml text
*.yaml text
*.toml text
*.txt text

# Binaries
*.png binary
*.jpg binary
*.ico binary
