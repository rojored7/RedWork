#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged for code formatting and linting
npx lint-staged

# Check for console.log statements in STAGED files only
echo "Checking for console.log statements in staged files..."
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E "\.(ts|tsx)$" | grep -v "test" | grep -v "spec" || true)
if [ -n "$STAGED_TS_FILES" ]; then
  CONSOLE_LOGS=$(echo "$STAGED_TS_FILES" | xargs grep -n "console\.log" 2>/dev/null | grep -v "// eslint-disable-line" | grep -v "// TODO:" || true)
  if [ -n "$CONSOLE_LOGS" ]; then
    echo "❌ Error: console.log statements found in staged production code:"
    echo "$CONSOLE_LOGS"
    echo "Please remove or replace with proper logging"
    exit 1
  fi
fi

echo "✅ Pre-commit checks passed"

# ============================================
# FRAMEWORK VALIDATION (CAPA 2)
# ============================================
echo ""
echo "🔒 FRAMEWORK QUALITY VALIDATION (CAPA 2)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

FAILED_GATES=()

# Check if backend files changed
if git diff --cached --name-only | grep -q "^backend/"; then
  echo ""
  echo "📦 Validating Backend..."

  cd backend

  # Compilation
  echo "  🏗️  Compiling..."
  if ! npm run build > /dev/null 2>&1; then
    echo "  ❌ Backend compilation FAILED"
    FAILED_GATES+=("Backend Compilation")
  else
    echo "  ✅ Compilation OK"
  fi

  # Linting
  echo "  🧹 Linting..."
  if ! npm run lint > /dev/null 2>&1; then
    echo "  ❌ Backend linting FAILED"
    FAILED_GATES+=("Backend Linting")
  else
    echo "  ✅ Linting OK"
  fi

  # Tests
  echo "  🧪 Running tests..."
  if ! npm test > /dev/null 2>&1; then
    echo "  ❌ Backend tests FAILED"
    FAILED_GATES+=("Backend Tests")
  else
    echo "  ✅ Tests OK"
  fi

  cd ..
fi

# Check if frontend files changed
if git diff --cached --name-only | grep -q "^frontend/"; then
  echo ""
  echo "⚛️  Validating Frontend..."

  cd frontend

  # TypeScript check
  echo "  📘 Type checking..."
  if ! npm run type-check > /dev/null 2>&1; then
    echo "  ❌ TypeScript errors found"
    FAILED_GATES+=("Frontend TypeScript")
  else
    echo "  ✅ TypeScript OK"
  fi

  # Build
  echo "  🏗️  Building..."
  if ! npm run build > /dev/null 2>&1; then
    echo "  ❌ Frontend build FAILED"
    FAILED_GATES+=("Frontend Build")
  else
    echo "  ✅ Build OK"
  fi

  # Linting
  echo "  🧹 Linting..."
  if ! npm run lint > /dev/null 2>&1; then
    echo "  ❌ Frontend linting FAILED"
    FAILED_GATES+=("Frontend Linting")
  else
    echo "  ✅ Linting OK"
  fi

  # Tests
  echo "  🧪 Running tests..."
  if ! npm test run > /dev/null 2>&1; then
    echo "  ❌ Frontend tests FAILED"
    FAILED_GATES+=("Frontend Tests")
  else
    echo "  ✅ Tests OK"
  fi

  cd ..
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Check if any gates failed
if [ ${#FAILED_GATES[@]} -eq 0 ]; then
  echo "✅ FRAMEWORK VALIDATION PASSED"
  echo ""
  exit 0
else
  echo "❌ FRAMEWORK VALIDATION FAILED - ${#FAILED_GATES[@]} gate(s) failed:"
  echo ""
  for gate in "${FAILED_GATES[@]}"; do
    echo "  ❌ $gate"
  done
  echo ""
  echo "🔧 Fix these issues before committing"
  echo ""
  echo "To bypass (NOT RECOMMENDED):"
  echo "  git commit --no-verify"
  echo ""
  exit 1
fi