#!/bin/bash
# Git Pre-Commit Hook - Validaciones Automáticas
# Previene commits con errores conocidos

set -e

echo ""
echo "🔒 Ejecutando validaciones pre-commit..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

ERRORS=0

# 1. Validar estructura de entities TypeORM
echo ""
echo "📦 Validando entities TypeORM..."
if bash scripts/validate-entities.sh; then
  echo "✅ Entities validadas correctamente"
else
  echo "❌ Validación de entities falló"
  ERRORS=$((ERRORS + 1))
fi

# 2. Validar que no haya console.log en archivos staged
echo ""
echo "🚫 Verificando console.log en archivos staged..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx)$' || true)

if [ ! -z "$STAGED_FILES" ]; then
  CONSOLE_LOGS=$(echo "$STAGED_FILES" | xargs grep -n "console\.log" || true)
  if [ ! -z "$CONSOLE_LOGS" ]; then
    echo "⚠️  WARNING: console.log encontrados en archivos staged:"
    echo "$CONSOLE_LOGS"
    echo ""
    echo "Considera usar un logger apropiado o remover los console.log antes de commitear."
    # No bloqueamos el commit, solo advertencia
  else
    echo "✅ No hay console.log en archivos staged"
  fi
fi

# 3. Validar que backend compile ANTES de commitear
echo ""
echo "🔨 Verificando que backend compile..."
if [ -d "backend/src" ]; then
  cd backend
  if npm run build > /dev/null 2>&1; then
    echo "✅ Backend compila correctamente"
    cd ..
  else
    echo "❌ ERROR: Backend no compila"
    echo ""
    echo "Ejecuta 'cd backend && npm run build' para ver los errores."
    cd ..
    ERRORS=$((ERRORS + 1))
  fi
fi

# 4. Validar que no se commiteen archivos .env con secrets
echo ""
echo "🔐 Verificando que no se commiteen secrets..."
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.env$' || true)

if [ ! -z "$ENV_FILES" ]; then
  echo "❌ ERROR: Intentando commitear archivos .env:"
  echo "$ENV_FILES"
  echo ""
  echo "Los archivos .env NUNCA deben commitearse por seguridad."
  echo "Usa .env.example para plantillas sin valores reales."
  ERRORS=$((ERRORS + 1))
else
  echo "✅ No se están commiteando archivos .env"
fi

# 5. Validar que no se commitee dist/ compilado
echo ""
echo "📁 Verificando que no se commitee dist/ compilado..."
DIST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/dist/' || true)

if [ ! -z "$DIST_FILES" ]; then
  echo "⚠️  WARNING: Intentando commitear archivos compilados de dist/:"
  echo "$DIST_FILES"
  echo ""
  echo "dist/ debería estar en .gitignore. Solo commitea código fuente."
  # No bloqueamos, solo advertencia
fi

# 6. Validar que mapper async no use .value directo
echo ""
echo "🔧 Verificando mappers async..."
MAPPER_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep 'repository\.ts$' || true)

if [ ! -z "$MAPPER_FILES" ]; then
  BAD_MAPPERS=$(echo "$MAPPER_FILES" | xargs grep -n "password\.value" || true)
  if [ ! -z "$BAD_MAPPERS" ]; then
    echo "⚠️  WARNING: Uso de password.value en mappers:"
    echo "$BAD_MAPPERS"
    echo ""
    echo "Los mappers deben usar 'await password.getHashedValue()' para VOs con hashing."
  else
    echo "✅ Mappers usan getHashedValue() correctamente"
  fi
fi

# ============================================
# 7. LINTING DE STAGED FILES (20-Code-Quality-Linting-Agent) - BLOQUEANTE
# ============================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔍 Validación de Linting (20-Code-Quality-Linting-Agent)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ ! -z "$STAGED_TS_FILES" ]; then
  echo ""
  echo "📝 Ejecutando ESLint en archivos staged..."

  # Backend files
  BACKEND_FILES=$(echo "$STAGED_TS_FILES" | grep '^backend/' || true)
  if [ ! -z "$BACKEND_FILES" ]; then
    echo "   Backend files: $(echo "$BACKEND_FILES" | wc -l) archivos"
    cd backend
    # Run eslint on staged backend files with --max-warnings 0
    BACKEND_LINT_ERRORS=0
    for file in $BACKEND_FILES; do
      # Remove 'backend/' prefix for eslint
      FILE_PATH="${file#backend/}"
      if [ -f "$FILE_PATH" ]; then
        if ! npx eslint "$FILE_PATH" --max-warnings 0 2>&1 | grep -qE "error|warning"; then
          echo "      ✅ $FILE_PATH"
        else
          echo "      ❌ $FILE_PATH tiene errores de linting"
          npx eslint "$FILE_PATH" --max-warnings 0 2>&1 | grep -E "error|warning" | head -5
          BACKEND_LINT_ERRORS=$((BACKEND_LINT_ERRORS + 1))
        fi
      fi
    done
    cd ..

    if [ $BACKEND_LINT_ERRORS -gt 0 ]; then
      echo ""
      echo "   ❌ $BACKEND_LINT_ERRORS archivos con errores de linting en backend"
      echo "   Ejecuta: cd backend && npm run lint -- --fix"
      ERRORS=$((ERRORS + 1))
    else
      echo "   ✅ Backend linting: CLEAN"
    fi
  fi

  # Frontend files
  FRONTEND_FILES=$(echo "$STAGED_TS_FILES" | grep '^frontend/' || true)
  if [ ! -z "$FRONTEND_FILES" ]; then
    echo "   Frontend files: $(echo "$FRONTEND_FILES" | wc -l) archivos"
    cd frontend
    FRONTEND_LINT_ERRORS=0
    for file in $FRONTEND_FILES; do
      FILE_PATH="${file#frontend/}"
      if [ -f "$FILE_PATH" ]; then
        if ! npx eslint "$FILE_PATH" --max-warnings 0 2>&1 | grep -qE "error|warning"; then
          echo "      ✅ $FILE_PATH"
        else
          echo "      ❌ $FILE_PATH tiene errores de linting"
          npx eslint "$FILE_PATH" --max-warnings 0 2>&1 | grep -E "error|warning" | head -5
          FRONTEND_LINT_ERRORS=$((FRONTEND_LINT_ERRORS + 1))
        fi
      fi
    done
    cd ..

    if [ $FRONTEND_LINT_ERRORS -gt 0 ]; then
      echo ""
      echo "   ❌ $FRONTEND_LINT_ERRORS archivos con errores de linting en frontend"
      echo "   Ejecuta: cd frontend && npm run lint -- --fix"
      ERRORS=$((ERRORS + 1))
    else
      echo "   ✅ Frontend linting: CLEAN"
    fi
  fi
else
  echo "   ℹ️  No hay archivos TypeScript staged para linting"
fi

# ============================================
# 8. SECURITY SCAN (19-Security-Review-Agent) - BLOQUEANTE
# ============================================
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🔒 Validación de Seguridad (19-Security-Review-Agent)"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

STAGED_ALL_FILES=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ ! -z "$STAGED_ALL_FILES" ]; then
  echo ""
  echo "🔍 Escaneando hardcoded secrets en staged files..."

  # Scan for hardcoded secrets (passwords, tokens, api keys)
  SECRETS_FOUND=0
  for file in $STAGED_ALL_FILES; do
    if [ -f "$file" ]; then
      # Skip certain file types
      if echo "$file" | grep -qE '\.(jpg|png|gif|pdf|lock|json)$'; then
        continue
      fi

      # Look for common secret patterns
      SECRET_PATTERNS=$(grep -nE "(password|secret|api_key|apiKey|token|ACCESS_KEY|SECRET_KEY)\s*[:=]\s*['\"][^'\"]{8,}" "$file" 2>/dev/null | \
        grep -v "process.env" | \
        grep -v "configService.get" | \
        grep -v "getenv" | \
        grep -v "your_" | \
        grep -v "example" | \
        grep -v "TODO" | \
        grep -v "// " || true)

      if [ ! -z "$SECRET_PATTERNS" ]; then
        echo "   ❌ Posibles secrets hardcodeados en: $file"
        echo "$SECRET_PATTERNS" | head -3
        SECRETS_FOUND=$((SECRETS_FOUND + 1))
      fi
    fi
  done

  if [ $SECRETS_FOUND -gt 0 ]; then
    echo ""
    echo "   ❌ CRÍTICO: $SECRETS_FOUND archivos con posibles secrets hardcodeados"
    echo ""
    echo "   Los secrets NUNCA deben estar hardcodeados en el código."
    echo "   Usa variables de entorno (process.env) o servicios de configuración."
    ERRORS=$((ERRORS + 1))
  else
    echo "   ✅ No se detectaron secrets hardcodeados en staged files"
  fi

  # Check for eval() usage (code injection risk)
  echo ""
  echo "🔍 Verificando uso de eval()..."
  EVAL_FOUND=0
  for file in $STAGED_ALL_FILES; do
    if [ -f "$file" ] && echo "$file" | grep -qE '\.(ts|tsx|js|jsx)$'; then
      if grep -q "eval(" "$file" 2>/dev/null; then
        echo "   ❌ eval() encontrado en: $file (CRÍTICO - Code Injection Risk)"
        EVAL_FOUND=$((EVAL_FOUND + 1))
      fi
    fi
  done

  if [ $EVAL_FOUND -gt 0 ]; then
    echo ""
    echo "   ❌ CRÍTICO: eval() encontrado en $EVAL_FOUND archivos"
    echo "   eval() es un riesgo crítico de seguridad (code injection)"
    ERRORS=$((ERRORS + 1))
  else
    echo "   ✅ No se detectó uso de eval()"
  fi

else
  echo "   ℹ️  No hay archivos staged para escanear"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ $ERRORS -eq 0 ]; then
  echo "✅✅✅ PRE-COMMIT VALIDATIONS PASSED"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 0
else
  echo "❌❌❌ PRE-COMMIT VALIDATIONS FAILED: $ERRORS errores críticos"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "Corrige estos errores antes de commitear."
  echo "Si necesitas hacer un commit de emergencia, usa: git commit --no-verify"
  exit 1
fi
