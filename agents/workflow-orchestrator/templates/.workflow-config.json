{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "description": "Workflow system configuration for automated development workflows with regression testing",

  "project": {
    "name": "my-project",
    "type": "nodejs",
    "description": "Project description",

    "backend": {
      "enabled": true,
      "framework": "express",
      "language": "typescript",
      "testRunner": "jest",
      "path": "backend/",
      "entryPoint": "backend/src/server.ts",
      "testCommand": "npm test",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev"
    },

    "frontend": {
      "enabled": true,
      "framework": "react",
      "language": "typescript",
      "testRunner": "vitest",
      "path": "frontend/",
      "entryPoint": "frontend/src/main.tsx",
      "testCommand": "npm test",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev"
    },

    "e2e": {
      "enabled": true,
      "framework": "playwright",
      "path": "e2e/",
      "testCommand": "npm run test:e2e",
      "visualRegressionPath": "e2e/visual-regression/baselines/"
    },

    "executor": {
      "enabled": false,
      "path": "executor/",
      "description": "Code execution service (if applicable)"
    }
  },

  "workflows": {
    "regression": {
      "enabled": true,
      "description": "Run ALL tests and compare with baseline",
      "blockOnFailure": true,
      "runOn": ["feature", "fix", "refactor"],
      "skipOn": ["docs", "ci", "config"]
    },

    "architecture": {
      "enabled": true,
      "description": "Validate architecture rules (CAS)",
      "mode": "advisory",
      "blockOnFailure": false,
      "rulesFile": ".arch-rules.ts"
    },

    "visual": {
      "enabled": true,
      "description": "Visual validation with Playwright MCP",
      "baselinesPath": "e2e/visual-regression/baselines/",
      "threshold": 0.01,
      "blockOnFailure": false
    },

    "baseline": {
      "enabled": true,
      "description": "Capture project state before changes",
      "autoCapture": true,
      "captureOn": ["feature-start", "fix-start"],
      "retention": {
        "keep": 10,
        "description": "Keep last 10 baselines"
      }
    }
  },

  "thresholds": {
    "minCoverage": {
      "lines": 70,
      "functions": 70,
      "branches": 60,
      "statements": 70
    },

    "maxRegressionFailures": 0,
    "maxArchViolations": 5,
    "maxVisualDiff": 1.0
  },

  "agents": {
    "orchestrator": {
      "name": "workflow-orchestrator",
      "description": "Main workflow coordinator",
      "mode": "semi-automatic"
    },

    "docker": {
      "name": "docker-wsl2-devops",
      "enabled": true,
      "invokeWhen": ["database", "migration", "infra", "docker"]
    },

    "backend": {
      "name": "backend-implementor",
      "enabled": true,
      "invokeWhen": ["always"]
    },

    "frontend": {
      "name": "frontend-builder",
      "enabled": true,
      "invokeWhen": ["always"]
    },

    "qa": {
      "name": "qa-tester-senior",
      "enabled": true,
      "invokeWhen": ["feature", "fix"]
    }
  },

  "directories": {
    "baselines": ".baselines/",
    "checkpoints": ".checkpoints/",
    "reports": "reports/",
    "visualBaselines": "e2e/visual-regression/baselines/",
    "coverage": "reports/coverage/",
    "logs": "logs/"
  },

  "git": {
    "autoCommit": false,
    "commitMessageTemplate": "{{type}}: {{description}}\n\n{{details}}",
    "branchNaming": "{{type}}/{{ticket}}-{{description}}",
    "requireCleanWorkingDirectory": false
  },

  "notifications": {
    "enabled": false,
    "channels": {
      "slack": {
        "enabled": false,
        "webhookUrl": "",
        "notifyOn": ["regression-failure", "workflow-complete"]
      },
      "email": {
        "enabled": false,
        "recipients": [],
        "notifyOn": ["regression-failure"]
      }
    }
  },

  "advanced": {
    "parallelExecution": {
      "enabled": true,
      "maxConcurrency": 2,
      "description": "Run backend and frontend tests in parallel"
    },

    "caching": {
      "enabled": true,
      "cacheBaselines": true,
      "cacheCoverage": true,
      "ttl": 86400
    },

    "retry": {
      "enabled": true,
      "maxAttempts": 2,
      "retryOn": ["network-error", "timeout"],
      "backoff": "exponential"
    },

    "cleanup": {
      "enabled": true,
      "cleanupAfter": ["workflow-complete"],
      "keepArtifacts": ["baselines", "reports"],
      "retention": {
        "days": 30
      }
    }
  },

  "metadata": {
    "createdAt": "2026-03-08T00:00:00Z",
    "createdBy": "workflow-orchestrator",
    "version": "1.0.0",
    "lastModified": "2026-03-08T00:00:00Z"
  }
}
